{
  "entities": {
    "Persona": {
      "title": "Persona",
      "description": "Perfil de usuario con roles e información básica",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Gamer peripheral product",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string", "enum": ["keyboards", "mice", "controllers"] },
        "active": { "type": "boolean" },
        "featured": { "type": "boolean" }
      },
      "required": ["name", "price", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "shipped", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "mercadopagoId": { "type": "string" }
      },
      "required": ["userId", "total", "status"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Contact form submission",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/personas/{userId}": {
      "schema": "Persona",
      "description": "Perfiles de usuario individuales"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Purchase orders history"
    },
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "User inquiries"
    },
    "/admins/{userId}": {
      "schema": { "type": "object", "properties": { "uid": { "type": "string" } } },
      "description": "List of admin UIDs for security rules"
    }
  }
}
